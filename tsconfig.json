{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/types/*": ["types/*"],
      "@/config/*": ["config/*"],
      "@/nodes/*": ["nodes/*"],
      "@/services/*": ["services/*"],
      "@/adapters/*": ["adapters/*"],
      "@/graph/*": ["graph/*"],
      "@/__tests__/*": ["__tests__/*"]
    },
    "baseUrl": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

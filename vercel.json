{
  "headers": [
    { "source": "/bot-control.html", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ],
  "crons": [
    {
      "path": "/api/refresh-token",
      "schedule": "59 15 * * *"
    }
  ],
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 60
    },
    "api/webhook-study.ts": {
      "maxDuration": 60
    }
  }
}

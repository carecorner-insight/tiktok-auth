{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "sourceMessageId", "receivedAt", "monthSGT", "dateSGT", "userKey", "isTester", "eligibility", "sessionId", "sessionStartedAt", "sessionStartObserved", "scenarioRunId", "scenarioStartedAt", "scenarioStartMonthSGT", "scenarioTag", "mode", "question", "response", "feedbackId", "readiness", "usefulness", "clarityBefore", "clarityAfter", "scriptChosen", "tier", "maxTierBeforeReferral", "tierHistoryComplete", "crisisDetected", "state8Reached", "referralId", "referralTarget", "referralSource", "deliveryStatus", "instrumentVersion", "policyVersion", "tierRubricVersion", "model", "promptVersion", "promptHash", "deploymentSha"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9:-]+$" },
    "eventType": { "type": "string", "enum": ["activity", "session_started", "scenario_started", "checkin_reached", "response_recorded", "feedback_offered", "script_selected", "tier_estimated", "referral_requested", "referral_delivered", "referral_clicked", "turn_completed"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sourceMessageId": { "type": ["string", "null"] },
    "receivedAt": { "type": "string", "format": "date-time" },
    "monthSGT": { "type": "string", "maxLength": 7 },
    "dateSGT": { "type": "string", "maxLength": 10 },
    "userKey": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "isTester": { "type": "boolean" },
    "eligibility": { "type": "string", "enum": ["eligible", "ineligible", "missing"] },
    "sessionId": { "type": ["string", "null"] },
    "sessionStartedAt": { "type": ["string", "null"] },
    "sessionStartObserved": { "type": "boolean" },
    "scenarioRunId": { "type": ["string", "null"] },
    "scenarioStartedAt": { "type": ["string", "null"] },
    "scenarioStartMonthSGT": { "type": ["string", "null"] },
    "scenarioTag": { "type": ["string", "null"], "enum": ["1", "2", "3", "4", "5", "6", null] },
    "mode": { "type": "string", "enum": ["prepare", "reflect", "missing"] },
    "question": { "type": "string", "enum": ["readiness", "usefulness", "clarityBefore", "clarityAfter", "missing"] },
    "response": { "type": "string", "enum": ["1", "2", "3", "yes", "no", "missing"] },
    "feedbackId": { "type": ["string", "null"] },
    "readiness": { "type": "string", "enum": ["1", "2", "3", "missing"] },
    "usefulness": { "type": "string", "enum": ["yes", "no", "missing"] },
    "clarityBefore": { "type": "string", "enum": ["1", "2", "3", "missing"] },
    "clarityAfter": { "type": "string", "enum": ["1", "2", "3", "missing"] },
    "scriptChosen": { "type": "string", "enum": ["yes", "no", "missing"] },
    "tier": { "type": "string", "enum": ["1", "2", "3", "4", "missing"] },
    "maxTierBeforeReferral": { "type": "string", "enum": ["1", "2", "3", "4", "missing"] },
    "tierHistoryComplete": { "type": "boolean" },
    "crisisDetected": { "type": "boolean" },
    "state8Reached": { "type": "boolean" },
    "referralId": { "type": ["string", "null"] },
    "referralTarget": { "type": "string", "enum": ["insight", "crest", "missing"] },
    "referralSource": { "type": "string", "enum": ["user_requested", "bot_suggested", "missing"] },
    "deliveryStatus": { "type": "string", "enum": ["received", "sent", "maintenance", "failed"] },
    "instrumentVersion": { "type": "string" },
    "policyVersion": { "type": "string" },
    "tierRubricVersion": { "type": "string" },
    "model": { "type": "string" },
    "promptVersion": { "type": "string" },
    "promptHash": { "type": ["string", "null"] },
    "deploymentSha": { "type": ["string", "null"] }
  }
}
